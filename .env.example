NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Desenvolvimento local: true desativa login apenas em NODE_ENV != production.
# Nunca habilite em produção.
DISABLE_AUTH=false
NEXT_PUBLIC_DISABLE_AUTH=false

# Provedor de IA (openai | anthropic | gemini) — padrão: openai
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Segredo dos cron jobs (Vercel Cron envia como Bearer token)
CRON_SECRET=

# MySQL/MariaDB CEVESP (apenas na rede SES-SP)
NOTIFY_DB_HOST=
NOTIFY_DB_PORT=3306
NOTIFY_DB_NAME=
NOTIFY_DB_USER=
NOTIFY_DB_PASSWORD=
NOTIFY_DB_TABLE=

# REDCap (Agente Tracoma) — opcional; sem configuração retorna dados de demonstração
REDCAP_API_URL=https://redcap.example.org/api/
REDCAP_API_TOKEN=
REDCAP_TRACOMA_FORM=tracoma_survey
